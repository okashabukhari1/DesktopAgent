<Window x:Class="DesktopAgent.App.Views.CharacterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DesktopAgent.App.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual" ShowActivated="True" Opacity="1"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.Name="Desktop Agent floating character">
    <Grid>
        <controls:CharacterControl x:Name="Character"
            Width="{Binding CharacterSize}" Height="{Binding CharacterSize}"
            State="{Binding Character.State}"
            AnimationEnabled="{Binding Character.AnimationEnabled}"
            AnimationIntensity="{Binding Character.AnimationIntensity}"
            MouseLeftButtonDown="Character_MouseLeftButtonDown"
            MouseLeftButtonUp="Character_MouseLeftButtonUp"
            MouseMove="Character_MouseMove"
            MouseRightButtonUp="Character_MouseRightButtonUp"
            ToolTip="Click to open · Drag to move · Right-click for options" />
    </Grid>
</Window>
