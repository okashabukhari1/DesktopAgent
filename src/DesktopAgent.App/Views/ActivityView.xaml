<UserControl x:Class="DesktopAgent.App.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Activity screen">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Activity" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Recent actions and their actual results, saved locally." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" />
            </StackPanel>
            <ComboBox x:Name="FilterBox" Width="180" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="Filter_SelectionChanged" />
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="#25667085" BorderThickness="1" CornerRadius="14" Margin="0,18,0,0" Padding="16">
            <Grid>
            <TextBlock x:Name="EmptyState" Text="No actions match this filter yet." Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ActivityItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#25667085" BorderThickness="0,0,0,1" Padding="3,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="104"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" Foreground="{DynamicResource MutedBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Source}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Action}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Target}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
