<Window x:Class="DesktopAgent.App.Views.NotificationBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="292" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize" IsHitTestVisible="True">
    <Border Background="#F7FFFFFF" CornerRadius="16" Padding="16" BorderBrush="#18000000" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="MessageText" Foreground="#182033" TextWrapping="Wrap" FontSize="14" LineHeight="20" />
            <Button Grid.Column="1" Content="×" Width="28" Height="28" Padding="0" Margin="10,0,0,0" VerticalAlignment="Top"
                    Background="#EEF0F6" Foreground="#4A5062" Click="Close_Click" ToolTip="Dismiss" />
        </Grid>
    </Border>
</Window>
