<UserControl x:Class="DesktopAgent.App.Views.WorkspacesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.Name="Workspaces screen">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Workspaces" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Open a repeatable desktop setup with one action." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" />
            </StackPanel>
            <Button Content="＋ New workspace" HorizontalAlignment="Right" VerticalAlignment="Center" Click="New_Click" AutomationProperties.Name="Create workspace" />
        </Grid>

        <Border x:Name="EmptyState" Grid.Row="1" Grid.RowSpan="2" Margin="0,28,0,0" Background="{DynamicResource CardBrush}"
                BorderBrush="#25667085" BorderThickness="1" CornerRadius="16" Padding="34" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                <Border Width="74" Height="74" CornerRadius="20" Background="#19665CF6">
                    <TextBlock Text="▦" FontSize="36" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Build your first workspace" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,6" />
                <TextBlock Text="Bundle applications, folders, files, and web pages, then arrange their windows automatically."
                           Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                <Button Content="Create workspace" HorizontalAlignment="Center" Margin="0,18,0,0" Click="New_Click" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" Margin="0,24,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="WorkspaceItems">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel IsItemsHost="True" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="292" MinHeight="210" Margin="0,0,16,16" Background="{DynamicResource CardBrush}" BorderBrush="#25667085" BorderThickness="1" CornerRadius="16" Padding="19">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid>
                                    <Border Width="44" Height="44" CornerRadius="12" Background="#19665CF6" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Glyph}" Foreground="{DynamicResource AccentBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button Content="Edit" Padding="9,5" Background="#E8EAF1" Foreground="#333A4A" Tag="{Binding Id}" Click="Edit_Click" />
                                        <Button Content="⋯" Padding="10,5" Background="#E8EAF1" Foreground="#333A4A" Tag="{Binding Id}" Click="More_Click" ToolTip="More actions" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="0,14,0,12">
                                    <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxHeight="42" Margin="0,5,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,8" />
                                <Button Grid.Row="3" Content="Launch workspace" HorizontalAlignment="Stretch" Tag="{Binding Id}" Click="Launch_Click" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border x:Name="ProgressPanel" Grid.Row="3" Margin="0,14,0,0" Padding="14" Background="#F7FFFFFF" BorderBrush="#30665CF6" BorderThickness="1" CornerRadius="12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ProgressTitle" FontWeight="SemiBold" />
                    <ProgressBar x:Name="LaunchProgress" Height="5" Margin="0,8,0,0" Minimum="0" Maximum="1" />
                    <TextBlock x:Name="ProgressMessage" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <TextBlock x:Name="ProgressDetails" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                    </ScrollViewer>
                </StackPanel>
                <Button Grid.Column="1" x:Name="CancelLaunchButton" Content="Cancel" Background="#E8EAF1" Foreground="#333A4A" Margin="14,0,0,0" Click="Cancel_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
