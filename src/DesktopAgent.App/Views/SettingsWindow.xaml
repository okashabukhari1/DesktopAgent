<Window x:Class="DesktopAgent.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DesktopAgent.App.Views"
        Title="Desktop Agent Settings" Width="780" Height="720" MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterScreen" AutomationProperties.Name="Desktop Agent Settings">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Tune your desktop companion." Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,18" />
        </StackPanel>
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="General">
                <StackPanel Margin="14">
                    <CheckBox Content="Launch application when Windows starts" IsChecked="{Binding StartWithWindows}" ToolTip="Registers for the current Windows user only" />
                    <CheckBox Content="Always on top" IsChecked="{Binding AlwaysOnTop}" />
                    <CheckBox Content="Remember character position" IsChecked="{Binding RememberPosition}" />
                    <CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized}" />
                    <CheckBox Content="Show character on startup" IsChecked="{Binding ShowCharacterOnStartup}" />
                    <Button Content="Review Permissions" HorizontalAlignment="Left" Margin="0,18,0,0" Click="Permissions_Click" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Character">
                <StackPanel Margin="14">
                    <TextBlock Text="Character size" FontWeight="SemiBold" />
                    <Slider Minimum="96" Maximum="240" Value="{Binding CharacterSize}" TickFrequency="12" IsSnapToTickEnabled="True" />
                    <TextBlock Text="{Binding CharacterSize, StringFormat={}{0:F0} px}" Foreground="{DynamicResource MutedBrush}" />
                    <CheckBox Content="Enable subtle animation" IsChecked="{Binding AnimationEnabled}" Margin="0,18,0,6" />
                    <TextBlock Text="Animation intensity" FontWeight="SemiBold" />
                    <Slider Minimum="0" Maximum="1" Value="{Binding AnimationIntensity}" TickFrequency="0.1" />
                    <Button Content="Reset character position" HorizontalAlignment="Left" Margin="0,20,0,0" Click="Reset_Click" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Appearance">
                <StackPanel Margin="14">
                    <TextBlock Text="Theme" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
                    <TextBlock Text="Theme applies after Save." Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0" />
                </StackPanel>
            </TabItem>
            <TabItem Header="AI">
                <ContentControl x:Name="AiSettingsHost" />
            </TabItem>
            <TabItem Header="Projects"><ContentControl x:Name="ProjectSettingsHost" /></TabItem>
            <TabItem Header="Files"><ContentControl x:Name="FileSettingsHost" /></TabItem>
            <TabItem Header="Developer Tools"><ContentControl x:Name="DeveloperSettingsHost" /></TabItem>
            <TabItem Header="UI Inspector"><ContentControl x:Name="UiInspectorHost" /></TabItem>
            <TabItem Header="Computer Use"><ContentControl x:Name="ComputerUseHost" /></TabItem>
            <TabItem Header="Advanced">
                <TabControl Margin="8"><TabItem Header="Windows Diagnostics"><ContentControl x:Name="WindowsDiagnosticsHost" /></TabItem></TabControl>
            </TabItem>
            <TabItem Header="Developer">
                <StackPanel Margin="14">
                    <TextBlock Text="Character state" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding DeveloperState}" />
                    <Button Content="Open local logs" HorizontalAlignment="Left" Margin="0,20,0,0" Click="Logs_Click" />
                    <TextBlock Text="The application is text-only in this phase. It does not start microphone, speech recognition, or speech output services. Screen capture, arbitrary input automation, terminal access, and remote access are not available."
                               TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,20,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C43D4C" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,180,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Background="#E5E7EF" Foreground="#333A4A" Click="Cancel_Click" />
                <Button Content="Save" IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
