<UserControl x:Class="DesktopAgent.App.Views.PermissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Permissions screen">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Permissions" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="These rules apply to Assistant actions, including direct commands in chat. Actions you select in the Applications and Workspaces pages remain user-controlled. Windows security prompts remain controlled by Windows." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Button Content="Reset to defaults" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Reset_Click" />
        </Grid>
        <ScrollViewer Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CapabilityGroups">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBrush}" BorderBrush="#25667085" BorderThickness="1" CornerRadius="11" Padding="14" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,12,0" />
                                                    <TextBlock Text="{Binding Details}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0" />
                                                </StackPanel>
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Policy, Mode=OneWay}" IsEnabled="{Binding CanConfigure}" VerticalAlignment="Center" Tag="{Binding Id}" SelectionChanged="Policy_SelectionChanged" AutomationProperties.Name="Permission policy" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
    </Grid>
</UserControl>
