<UserControl x:Class="DesktopAgent.App.Views.ApplicationsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" AutomationProperties.Name="Applications screen">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid><StackPanel><TextBlock Text="Applications" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="CatalogStatus" Text="Applications available on this PC" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel><Button x:Name="RefreshButton" Content="↻ Refresh Applications" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Refresh_Click"/></Grid>
        <TextBox x:Name="SearchInput" Grid.Row="1" Margin="0,20,0,10" Padding="13,9" TextChanged="SearchInput_TextChanged" AutomationProperties.Name="Search applications" ToolTip="Search by application name or alias" />
        <TextBlock x:Name="SectionTitle" Grid.Row="2" Text="Installed" FontSize="16" FontWeight="SemiBold" Margin="2,4,0,8"/>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ApplicationItems"><ItemsControl.ItemTemplate><DataTemplate>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="#24667085" BorderThickness="1" CornerRadius="13" Padding="13" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="9" Background="#11665CF6"><Grid><Image Source="{Binding Icon}" Width="32" Height="32"/><TextBlock Text="▦" FontSize="21" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding FallbackVisibility}"/></Grid></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold"/><Border Background="#1632A05F" CornerRadius="8" Margin="8,0,0,0" Padding="7,2" Visibility="{Binding RunningVisibility}"><TextBlock Text="Running" Foreground="#32805B" FontSize="11"/></Border></StackPanel><TextBlock Text="{Binding Secondary}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{Binding FavoriteGlyph}" Background="#E8EAF1" Foreground="#665CF6" Padding="10,7" Tag="{Binding}" Click="Favorite_Click" ToolTip="Favorite"/><Button Content="{Binding PrimaryAction}" Tag="{Binding}" Click="Primary_Click"/><Button Content="⋯" Background="#E8EAF1" Foreground="#333A4A" Padding="10,7" Tag="{Binding}" Click="More_Click" Visibility="{Binding RunningVisibility}"/></StackPanel>
            </Grid></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </Grid>
</UserControl>
