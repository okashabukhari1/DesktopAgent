<UserControl x:Class="DesktopAgent.App.Views.AiSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="AI provider settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14">
            <TextBlock Text="AI provider" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Natural-language requests send only the conversation text and requested structured tool results to this provider. API credentials are stored in Windows Credential Manager." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,15" />
            <TextBlock Text="Provider" FontWeight="SemiBold" /><ComboBox x:Name="ProviderBox" DisplayMemberPath="Name" SelectionChanged="Provider_SelectionChanged" />
            <TextBlock Text="API base URL" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBox x:Name="BaseUrlBox" />
            <TextBlock Text="Model" FontWeight="SemiBold" Margin="0,12,0,0" />
            <DockPanel>
                <Button x:Name="FetchModelsButton" Content="Fetch models" DockPanel.Dock="Right" Margin="8,0,0,0" Click="FetchModels_Click" />
                <ComboBox x:Name="ModelBox" IsEditable="True" IsTextSearchEnabled="True" />
            </DockPanel>
            <TextBlock Text="Choose a provider to fill its API URL. Models are fetched from its /models API when a saved key is available; you can also type a model name." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Text="API credential" FontWeight="SemiBold" Margin="0,12,0,0" /><PasswordBox x:Name="ApiKeyBox" />
            <TextBlock x:Name="CredentialStatus" Text="No credential saved" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
            <TextBlock Text="Leave blank to keep the saved key, or enter a replacement." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Text="Request timeout (seconds)" FontWeight="SemiBold" Margin="0,12,0,0"/>
            <TextBox x:Name="TimeoutBox" MaxLength="3" ToolTip="10 to 180 seconds"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="TestButton" Content="Save and test connection" Click="Test_Click" />
                <Button Content="Remove saved credential" Margin="8,0,0,0" Click="Remove_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
            <Separator Margin="0,18,0,14" />
            <TextBlock Text="Behavior" FontWeight="SemiBold" />
            <CheckBox x:Name="AiEnabledBox" Content="Enable cloud AI for natural-language requests" IsChecked="True" Margin="0,9,0,0" />
            <CheckBox x:Name="ToolActivityBox" Content="Show tool activity in the conversation" IsChecked="True" Margin="0,6,0,0" />
            <TextBlock Text="Sensitive actions follow Allow, Ask, or Deny in Permissions. Conversation history is session-only in this version." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
