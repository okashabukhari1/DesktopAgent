<Window x:Class="DesktopAgent.App.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Desktop Agent" Width="760" Height="620" MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        AutomationProperties.Name="Desktop Agent onboarding">
    <Grid Margin="34">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="StepText" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
            <ProgressBar x:Name="StepProgress" Height="4" Minimum="0" Maximum="9" Margin="0,8,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="#25667085" BorderThickness="1" CornerRadius="18" Padding="28" Margin="0,20,0,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="BodyText" Foreground="{DynamicResource MutedBrush}" FontSize="15" LineHeight="23" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <StackPanel x:Name="ChoicePanel" Margin="0,18,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BackButton" Content="Back" Click="Back_Click" IsEnabled="False" />
                <Button x:Name="SkipAiButton" Content="Skip for now" Margin="8,0,0,0" Click="SkipAi_Click" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel x:Name="NextButtons" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="NextButton" Content="Continue" IsDefault="True" Click="Next_Click" />
                <Button x:Name="OpenAssistantButton" Content="Open Assistant" Click="OpenAssistant_Click" Visibility="Collapsed" />
                <Button x:Name="ReviewPermissionsButton" Content="Review Permissions" Margin="8,0,0,0" Click="ReviewPermissions_Click" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
