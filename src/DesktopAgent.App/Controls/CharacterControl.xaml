<UserControl x:Class="DesktopAgent.App.Controls.CharacterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:DesktopAgent.Core.Enums;assembly=DesktopAgent.Core"
             Background="Transparent" Focusable="True"
             AutomationProperties.Name="Desktop Agent character">
    <Grid x:Name="FloatRoot" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><TranslateTransform x:Name="FloatTransform" /></Grid.RenderTransform>
        <Ellipse Margin="18,24,18,8" Fill="#22000000" VerticalAlignment="Bottom" Height="18" />
        <Border x:Name="Orb" Margin="12" CornerRadius="80" BorderThickness="2" BorderBrush="#55FFFFFF">
            <Border.Background>
                <RadialGradientBrush Center="0.35,0.3" GradientOrigin="0.3,0.25" RadiusX="0.75" RadiusY="0.75">
                    <GradientStop x:Name="Glow" Color="#9D96FF" Offset="0" />
                    <GradientStop x:Name="Body" Color="#5B50D6" Offset="0.58" />
                    <GradientStop Color="#332B78" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
            <Grid>
                <Grid x:Name="Face" Margin="27,34,27,28">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Ellipse x:Name="LeftEye" Width="13" Height="19" Fill="White" Margin="5" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform x:Name="LeftBlink"/></Ellipse.RenderTransform></Ellipse>
                    <Ellipse x:Name="RightEye" Grid.Column="1" Width="13" Height="19" Fill="White" Margin="5" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform x:Name="RightBlink"/></Ellipse.RenderTransform></Ellipse>
                    <Path Grid.ColumnSpan="2" Data="M 15,36 Q 30,48 45,36" Stroke="White" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Grid>
                <Ellipse x:Name="PulseRing" Margin="5" Stroke="#99FFFFFF" StrokeThickness="2" Opacity="0" />
                <TextBlock x:Name="Indicator" Text="•••" FontSize="20" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,13,0,0" Opacity="0" />
            </Grid>
        </Border>
    </Grid>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard x:Name="AmbientStoryboard">
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="FloatTransform" Storyboard.TargetProperty="Y" From="1" To="-3" Duration="0:0:2.8" />
                    <DoubleAnimation Storyboard.TargetName="Orb" Storyboard.TargetProperty="Opacity" From="0.96" To="1" Duration="0:0:2.8" />
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftBlink" Storyboard.TargetProperty="ScaleY" Duration="0:0:6">
                        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:4" Value="1"/>
                        <LinearDoubleKeyFrame KeyTime="0:0:4.06" Value="0.12"/><LinearDoubleKeyFrame KeyTime="0:0:4.18" Value="1"/>
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightBlink" Storyboard.TargetProperty="ScaleY" Duration="0:0:6">
                        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:4" Value="1"/>
                        <LinearDoubleKeyFrame KeyTime="0:0:4.06" Value="0.12"/><LinearDoubleKeyFrame KeyTime="0:0:4.18" Value="1"/>
                    </DoubleAnimationUsingKeyFrames>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
